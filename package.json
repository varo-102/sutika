{
  "name": "sutika",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@pollar/core": "0.12.0",
    "@pollar/react": "0.12.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.4.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
